Configs: {
	YarnResearchConfig: {
		DisplayName: YARN Config

		Headers: {
			Features: Automation Settings
			Options: Misc. Settings
		}

		AutoResearchHeldItems: {
			Label: Auto-Research Held Items
			Tooltip: Automatically research items without sacrificing if you hold enough in your inventory
		}

		AutoResearchCraftable: {
			Label: Auto-Research Craftable Items
			Tooltip: Automatically research items where you've researched all crafting requirements
		}

		AutoResearchShimmerOutputs: {
			Tooltip: Automatically research items you can get from shimmering researched items, as long as you've discovered the Aether
			Label: Auto-Research Shimmer Outputs
		}

		AutoResearchCrateContents: {
			Tooltip: Automatically research all possible contents of any researched grab bags (e.g. fishing crates, boss loot bags)
			Label: Auto-Research Grab Bag Contents
		}

		AutoResearchMiscCascades: {
			Tooltip: Automatically research miscellaneous shortcuts like torch god conversions and extractinator outputs
			Label: Auto-Research Misc. Sources
		}

		AutoResearchShopStock: {
			Tooltip: Automatically research the affordable stock of a shop you open
			Label: Auto-Research Shop Stock
		}

		SharePartialResearch: {
			Label: Share Partial Research
			Tooltip: In multiplayer, share partial research progress with your team instead of only completed research
		}

		InfiniteResearchedConsumables: {
			Label: Researched Stacks Don't Decrease
			Tooltip: A stack of a researched item won't go down when used
		}

		InfiniteResearchedBuffs: {
			Tooltip: A buff from a researched potion/food/etc can be toggled to remain active infinitely
			Label: Researched Buffs Don't Expire
		}

		ShowAutoResearchNotifications: {
			Label: Show Notifications in Chat
			Tooltip: Show a summary in chat when items are automatically researched
		}
	}
}

Keybinds: {
	ResearchCrateContents.DisplayName: Research Grab Bag Contents
	ToggleInfiniteBuff.DisplayName: Toggle Infinite Buff
	OpenPrefixPicker.DisplayName: Choose Modifier
}

YarnResearchGlobalItem: {
	ResearchCrateContentsHint: Press {0} to research contents
	ToggleInfiniteBuffHint: Press {0} to toggle buff
	OpenPrefixPickerHint: Press {0} to choose modifier
	PrefixPickerPopupSetDefaultHint: Left-click to set default modifier
	PrefixPickerPopupDuplicateHint: Right-click to duplicate once
}

PrefixCandidate.NoPrefix: "[none]"

ResearchCascadeSystem: {
	Notification: "{0}: {1}"
	TeammateNotification: "{0} by {1}: {2}"

	Origins: {
		Held: Auto-Researched
		Craftable: Auto-Crafted
		BiomeTorch: Auto-Swapped
		Extractinator: Auto-Extracted
		Shimmer: Auto-Shimmered
		Crate: Auto-Looted
		Shop: Auto-Purchased
		Team: Researched by teammates
	}
}

InfiniteBuffSystem.BuffBarFull: Can't toggle buff - at buff cap
JourneyMenuTriggersButton.Tooltip: YARN Powers
HeldItemsActionPower.HoverText: Research Held Items
CascadeActionPower.HoverText: Research Craftable Recipes
MiscCascadeActionPower.HoverText: Research Misc. Sources
ShimmerActionPower.HoverText: Research Shimmered Items
TeamCatchupPower.HoverText: Sync With Teammate Resarch

FreeCraftingTogglePower: {
	HoverText: Craft Anywhere Disabled
	ActiveHoverText: Craft Anywhere Enabled
}

SacrificeActionPower: {
	HoverText: Consume Unresearched Items
	ArmedHoverText: Consume Unresearched Items - Click again to confirm!
}

ClearActionPower: {
	HoverText: Clear Researched Items
	ArmedHoverText: Clear Researched Items - Click again to confirm!
}
