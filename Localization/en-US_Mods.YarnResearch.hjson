Keybinds: {
	ResearchCrateContents.DisplayName: Research Crate Contents
	ToggleInfiniteBuff.DisplayName: Toggle Infinite Buff
	OpenPrefixPicker.DisplayName: Open Prefix Picker
}

YarnResearchGlobalItem: {
	ResearchCrateContentsHint: Press {0} to research its possible contents
	ToggleInfiniteBuffHint: Press {0} to toggle its buff as infinite
	OpenPrefixPickerHint: Press {0} to choose its duplication prefix
	PrefixPickerPopupSetDefaultHint: Left-click to set as default
	PrefixPickerPopupDuplicateHint: Right-click to duplicate once
}

ResearchCascadeSystem: {
	Notification: "{0}: {1}"

	Origins: {
		Held: Auto-researched
		Craftable: Auto-crafted
		BiomeTorch: Auto-converted
		Extractinator: Auto-extracted
		Shimmer: Auto-discovered
		Crate: Auto-unpacked
		Sacrifice: Sacrificed
		Shop: Auto-researched from shop
	}
}

InfiniteBuffSystem.BuffBarFull: Your buff bar is full - can't toggle this on right now
JourneyMenuTriggersButton.Tooltip: YARN manual research triggers
HeldItemsActionPower.HoverText: Research Held Items
CascadeActionPower.HoverText: Research Craftable Recipes
ShimmerActionPower.HoverText: Research Shimmered Items

FreeCraftingTogglePower: {
	HoverText: Free Crafting - off
	ActiveHoverText: Free Crafting - on (researched stations count as nearby)
}

SacrificeActionPower: {
	HoverText: Sacrifice Unresearched Items
	ArmedHoverText: Click again to confirm - sacrifices all unresearched items in your inventory!
}

ClearActionPower: {
	HoverText: Clear Fully-Researched Items
	ArmedHoverText: Click again to confirm - destroys all fully-researched items in your inventory!
}
